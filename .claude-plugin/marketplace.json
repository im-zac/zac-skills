{
  "name": "zac-skills",
  "description": "im-zac 的 Claude Code plugins",
  "owner": {
    "name": "im-zac",
    "url": "https://github.com/im-zac"
  },
  "plugins": [
    {
      "name": "worklog",
      "description": "把 Claude Code session 的工作、進度、決策記在一個隨時能打開看的 artifact 頁面；有重要進展或需要決策時推播通知。",
      "author": {
        "name": "im-zac",
        "url": "https://github.com/im-zac"
      },
      "source": "./plugins/worklog",
      "category": "productivity",
      "homepage": "https://github.com/im-zac/zac-skills/tree/main/plugins/worklog"
    },
    {
      "name": "session-orchestrator",
      "description": "用一個 orchestrator session 在 tmux 裡開出、archive、resume、close 其他 Claude Code session，並在 artifact 總表看每個 session 的狀態。",
      "author": {
        "name": "im-zac",
        "url": "https://github.com/im-zac"
      },
      "source": "./plugins/session-orchestrator",
      "category": "productivity",
      "homepage": "https://github.com/im-zac/zac-skills/tree/main/plugins/session-orchestrator"
    },
    {
      "name": "telecipher",
      "description": "session 需要 token／API key 時向 telecipher 登錄需求，使用者在 telecipher 頁面填值直接寫檔，值不經 Claude 對話。",
      "author": {
        "name": "im-zac",
        "url": "https://github.com/im-zac"
      },
      "source": "./plugins/telecipher",
      "category": "productivity",
      "homepage": "https://github.com/im-zac/zac-skills/tree/main/plugins/telecipher"
    },
    {
      "name": "task-orchestrator",
      "description": "派工主控 session：查證、派工給 subagent、抽查、走 PR，並在 worklog 頁面維護派工主控台。專案的 tracker、repo、流程寫在設定檔。",
      "author": {
        "name": "im-zac",
        "url": "https://github.com/im-zac"
      },
      "source": "./plugins/task-orchestrator",
      "category": "productivity",
      "homepage": "https://github.com/im-zac/zac-skills/tree/main/plugins/task-orchestrator"
    }
  ]
}
